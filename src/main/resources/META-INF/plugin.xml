<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>com.c75.MagicCodeCompletion</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>MagicCodeCompletion</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/avin">avin</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        JetBrains IDEs plugin for AI-assisted code completion using OpenAI-compatible APIs with agentic file reading and multi-edit capabilities.<br>
        <br>
        <strong>How to Use:</strong><br>
        1. Open <strong>Tools → Magic Code Completion</strong> in your IDE<br>
        2. Configure API access to your LLM (we recommend using advanced reasoning models for better code quality)<br>
        3. Specify glob patterns for files you want the LLM to see - during completion generation, the LLM will see the list of these files and can read them if needed to expand context<br>
        4. Place your cursor at the location where you want code completion<br>
        5. Press <strong>Alt+I</strong><br>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    
    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        
        <!-- Notification group for debug messages -->
        <notificationGroup id="Magic Code Completion" displayType="BALLOON"/>
        
        <!-- Notification group for code changes -->
        <notificationGroup id="MagicCodeCompletion.Changes" displayType="BALLOON"/>
        
        <!-- Settings page -->
        <projectConfigurable 
            parentId="tools"
            instance="com.c75.magiccodecompletion.settings.MagicCodeCompletionConfigurable"
            id="com.c75.magiccodecompletion.settings.MagicCodeCompletionConfigurable"
            displayName="Magic Code Completion"/>
        
        <!-- Application-level services -->
        <applicationService serviceImplementation="com.c75.magiccodecompletion.settings.MagicCodeCompletionSettings"/>
        <applicationService serviceImplementation="com.c75.magiccodecompletion.service.LLMService"/>
        
        <!-- Project-level services -->
        <projectService serviceImplementation="com.c75.magiccodecompletion.settings.MagicCodeCompletionProjectSettings"/>
        <projectService serviceImplementation="com.c75.magiccodecompletion.services.FileTreeService"/>
    </extensions>
    
    <!-- Actions -->
    <actions>
        <action id="MagicCodeCompletion.InsertCodeFromLLM"
                class="com.c75.magiccodecompletion.action.InsertCodeFromLLMAction"
                text="Insert Code from LLM"
                description="Send code with cursor marker to LLM and insert generated code">
            <add-to-group group-id="EditorActions" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt I"/>
        </action>
    </actions>
</idea-plugin>
